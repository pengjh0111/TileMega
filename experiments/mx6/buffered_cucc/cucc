#!/usr/bin/env python3
"""Buffer compiler diagnostics verbatim; pass every compiler argument unchanged."""
from pathlib import Path
import hashlib,json,os,resource,subprocess,sys,time
REAL=Path('/opt/maca/tools/cu-bridge/bin/cucc')
EXPECTED='b589e8c42532401aa363ef288ca056a9aad555b29f7370997a416372c4cac7fe'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
assert sha(REAL)==EXPECTED,'underlying cucc changed'
arguments=[str(REAL),*sys.argv[1:]]
start=time.time();cpu0=resource.getrusage(resource.RUSAGE_CHILDREN);nbytes=0
p=subprocess.Popen(arguments,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
while True:
 data=p.stdout.read(1<<20)
 if not data:break
 sys.stdout.buffer.write(data);nbytes+=len(data)
sys.stdout.buffer.flush();returncode=p.wait();cpu1=resource.getrusage(resource.RUSAGE_CHILDREN)
assert sha(REAL)==EXPECTED,'underlying cucc changed during compile'
if '-o'in arguments:
 output=Path(arguments[arguments.index('-o')+1]).resolve()
 if Path('/root/tilemega/runs/mx6')in output.parents:
  receipt=Path(str(output)+'.actual_toolchain.json')
  with receipt.open('x')as f:
   json.dump(dict(kind='verbatim_buffered_cucc',argv=arguments,wrapper_argv=sys.argv,wrapper_sha256=sha(__file__),compiler_sha256=EXPECTED,start=start,end=time.time(),compiler_returncode=returncode,output_bytes=nbytes,compiler_user_seconds=cpu1.ru_utime-cpu0.ru_utime,compiler_system_seconds=cpu1.ru_stime-cpu0.ru_stime,compiler_arguments_modified=False,device_flags_modified=False,MIR_retained=True),f,indent=2);f.write('\n')
raise SystemExit(returncode if returncode>=0 else 128-returncode)
