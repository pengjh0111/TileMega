+int TaskRegister::register_moe_linear_sm80_task(
+    threadblock::Graph const &bgraph, bool w13_linear) {
+  assert(bgraph.operators.size() == 5 && bgraph.block_dim.x == 128);
+  auto const &input = static_cast<tb::TBInputOp *>(bgraph.operators.at(0))->dtensor;
+  auto const &weight = *static_cast<tb::TBInputOp *>(bgraph.operators.at(1));
+  auto const &routing =
+      static_cast<tb::TBInputOp *>(bgraph.operators.at(2))->dtensor;
+  auto const &mask = static_cast<tb::TBInputOp *>(bgraph.operators.at(3))->dtensor;
+  auto const &output = *static_cast<tb::TBInputOp *>(bgraph.operators.at(4));
+  int const batch = input.dim[0];
+  int const experts = weight.dtensor.dim[0];
+  int const topk = output.dtensor.dim[1];
+  int const width = output.output_tensors[0].dim[2];
+  int const stride = output.dtensor.dim[2];
+  int const reduction = weight.dtensor.dim[2];
+  assert(input.num_dims == (w13_linear ? 2 : 3));
+  assert(output.dtensor.num_dims == 3 && weight.dtensor.num_dims == 3);
+  assert(input.dim[input.num_dims - 1] == reduction);
+  assert(w13_linear || input.dim[1] == topk);
+  assert(weight.dtensor.dim[1] == stride &&
+         weight.output_tensors[0].dim[1] == width);
+  assert(routing.dim[0] == experts && routing.dim[1] == batch &&
+         mask.dim[0] == experts + 1);
+  assert(batch > 0 && batch <= 16 && width == 128 && stride % width == 0 &&
+         reduction % 128 == 0 && reduction >= 256);
+
+  mirage::transpiler::CodeKeeper code;
+  code.e("kernel::moe_linear_kernel<cute::bfloat16_t, $, $, $, $, $, $, $, "
+         "true, 3, $>(",
+         batch, width, stride, reduction, experts, topk,
+         bgraph.grid_dim.x, w13_linear ? "false" : "true");
+  code.e("    task_desc->input_ptrs[0], task_desc->input_ptrs[1], nullptr,");
+  code.e("    task_desc->input_ptrs[2], task_desc->input_ptrs[3],");
+  code.e("    task_desc->output_ptrs[0], task_desc->task_metadata.expert_offset);");
+  return register_task_variant(
+      w13_linear ? TASK_MOE_W13_LINEAR_SM80 : TASK_MOE_W2_LINEAR_SM80,
+      code.to_string());
+}
