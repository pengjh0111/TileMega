#!/usr/bin/env bash
# ==============================================================================
# tilemega-compile -- one-step MLIR to cubin pipeline (skeleton P0.2)
#
# Wraps three steps:
#   cuda-tile-opt        verify the IR
#   cuda-tile-translate  MLIR -> .tilebc (Tile IR bytecode)
#   tileiras             .tilebc -> .cubin (closed-source backend)
#
# Why wrap this instead of writing the commands out by hand everywhere:
#   1. Every R1/R2 experiment directory carried its own run.sh with slightly
#      different commands (bytecode version and tileiras path both varied), so
#      later reproduction could not determine which combination was used.
#   2. tileiras is a closed-source black box whose BEHAVIOUR DIFFERS MATERIALLY
#      BETWEEN VERSIONS (measured in V0: 13.1 and 13.3 emit REQNTID 256 and 128
#      respectively, which directly changes occupancy and the cooperative launch
#      limit). The tileiras version must therefore be an explicit, recorded
#      parameter rather than whatever happens to be first on PATH.
#   3. Every compilation emits a .env.json capturing the full environment, so
#      any cubin can be traced back to the toolchain that produced it.
# ==============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD="${TILEMEGA_BUILD_DIR:-$ROOT/build}"

GPU_ARCH="${TILEMEGA_GPU_ARCH:-sm_120}"
BC_VERSION="${TILEMEGA_BYTECODE_VERSION:-13.3}"
TILEIRAS="${TILEMEGA_TILEIRAS:-/data/cuda-13.3.1/bin/tileiras}"
KEEP_INTERMEDIATE=0
OUT=""

usage() {
  cat <<EOF
Usage: tilemega-compile [options] <input.mlir>

Options:
  -o <file>        output cubin path (default: <input>.cubin)
  --arch <arch>    GPU architecture (default: $GPU_ARCH)
  --tileiras <p>   path to tileiras (default: $TILEIRAS)
  --bc-version <v> Tile IR bytecode version (default: $BC_VERSION)
  --keep           keep the intermediate .tilebc
  -h, --help       this help

Environment: TILEMEGA_GPU_ARCH / TILEMEGA_TILEIRAS / TILEMEGA_BYTECODE_VERSION
             TILEMEGA_BUILD_DIR

Note: the tileiras version materially affects the output (see V0: REQNTID is
      256 under 13.1 and 128 under 13.3). The <out>.env.json written by every
      compilation records the full toolchain; treat it as authoritative when
      reproducing a result.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) OUT="$2"; shift 2;;
    --arch) GPU_ARCH="$2"; shift 2;;
    --tileiras) TILEIRAS="$2"; shift 2;;
    --bc-version) BC_VERSION="$2"; shift 2;;
    --keep) KEEP_INTERMEDIATE=1; shift;;
    -h|--help) usage; exit 0;;
    -*) echo "unknown option: $1" >&2; usage >&2; exit 2;;
    *) INPUT="$1"; shift;;
  esac
done

[[ -n "${INPUT:-}" ]] || { echo "error: no input .mlir given" >&2; usage >&2; exit 2; }
[[ -f "$INPUT" ]] || { echo "error: no such file: $INPUT" >&2; exit 1; }

CT_OPT="$(find "$BUILD" -name cuda-tile-opt -type f 2>/dev/null | head -1)"
CT_TRANSLATE="$(find "$BUILD" -name cuda-tile-translate -type f 2>/dev/null | head -1)"
for t in "$CT_OPT:cuda-tile-opt" "$CT_TRANSLATE:cuda-tile-translate"; do
  p="${t%%:*}"; n="${t##*:}"
  [[ -x "$p" ]] || { echo "error: $n not found under $BUILD; run: ninja -C build $n" >&2; exit 1; }
done
[[ -x "$TILEIRAS" ]] || { echo "error: tileiras is not executable: $TILEIRAS" >&2; exit 1; }

BASE="${INPUT%.mlir}"
OUT="${OUT:-$BASE.cubin}"
TILEBC="${OUT%.cubin}.tilebc"

echo "[1/3] verify IR      : $CT_OPT"
"$CT_OPT" "$INPUT" -o /dev/null

echo "[2/3] MLIR -> tilebc : bytecode $BC_VERSION"
"$CT_TRANSLATE" "$INPUT" \
  --mlir-to-cudatilebc --no-implicit-module \
  --bytecode-version="$BC_VERSION" -o "$TILEBC"

echo "[3/3] tilebc -> cubin : $GPU_ARCH, $("$TILEIRAS" --version 2>&1 | tail -1)"
"$TILEIRAS" --gpu-name "$GPU_ARCH" "$TILEBC" -o "$OUT"

# Environment snapshot. The lesson from R1: conclusions are tightly bound to
# toolchain versions, and a conclusion that cannot be traced back is void.
cat > "${OUT}.env.json" <<EOF
{
  "input"          : "$(realpath "$INPUT")",
  "output"         : "$(realpath "$OUT")",
  "gpu_arch"       : "$GPU_ARCH",
  "bytecode_version": "$BC_VERSION",
  "tileiras"       : "$TILEIRAS",
  "tileiras_version": "$("$TILEIRAS" --version 2>&1 | tail -1 | tr -d '\n')",
  "cuda_tile_commit": "$(git -C "$ROOT/third_party/cuda-tile" rev-parse HEAD 2>/dev/null || echo unknown)",
  "tensor_ir_commit": "$(git -C "$ROOT/third_party/tensor-ir" rev-parse HEAD 2>/dev/null || echo unknown)",
  "tilemega_commit" : "$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)",
  "driver"         : "$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)",
  "gpu"            : "$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)",
  "timestamp"      : "$(date -Is)"
}
EOF

[[ $KEEP_INTERMEDIATE -eq 1 ]] || rm -f "$TILEBC"

echo "done: $OUT"
echo "     toolchain snapshot: ${OUT}.env.json"
cuobjdump --dump-resource-usage "$OUT" 2>/dev/null | grep -E "Function|REG:" | sed 's/^/     /'
