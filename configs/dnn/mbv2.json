{
  "model": {
    "name": "mbv2"
  },
  "workload": {
    "batch": [
      1,
      8,
      32
    ]
  },
  "data": {
    "path": "/root/datasets/imagenetv2"
  },
  "target": "configs/targets/sm_89.json",
  "device": {
    "cache_dir": "~/.cache/tilemega-dm"
  },
  "solver": {
    "passes": 2,
    "jobs": 1,
    "time_budget_s": 1800,
    "calibration_reference": "docs/experiments/DNN_MOE_R1/inputs/regression/llama_B1/prefill/target.json"
  },
  "features": {
    "pg": "l2",
    "forward_executor": "L2",
    "reuse": "auto"
  },
  "output": {
    "dir": "runs/dm1-mbv2"
  }
}
