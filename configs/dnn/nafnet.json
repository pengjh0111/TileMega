{
  "model": {
    "name": "nafnet",
    "nafnet_weights": "/root/models/nafnet/NAFNet-SIDD-width32.pth"
  },
  "workload": {
    "batch": [
      1
    ]
  },
  "data": {
    "path": "/root/datasets/sidd"
  },
  "target": "configs/targets/sm_89.json",
  "device": {
    "cache_dir": "~/.cache/tilemega-dm"
  },
  "solver": {
    "passes": 2,
    "jobs": 1,
    "time_budget_s": 1800
  },
  "features": {
    "pg": "l2",
    "forward_executor": "L2",
    "reuse": "auto"
  },
  "output": {
    "dir": "runs/dm1-nafnet"
  }
}
