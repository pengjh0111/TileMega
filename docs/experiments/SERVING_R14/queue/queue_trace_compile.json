[
  {
    "name": "TR4_compile",
    "gpu": false,
    "priority": 0,
    "cwd": "/root/TileMega",
    "after": [
      "P0_trace_analyze"
    ],
    "timeout_s": 2400,
    "command": [
      "flock",
      "/root/r14_work/gpu.lock",
      "/usr/local/cuda/bin/nvcc",
      "-std=c++17",
      "-O3",
      "-DTILEMEGA_MIDPOINT_REFINE=0",
      "-arch=sm_89",
      "-DTILEMEGA_NONPAGED_TILED=0",
      "-DTILEMEGA_SYNC_V3=1",
      "-DTILEMEGA_EVENT_RED_PUBLISH=1",
      "-DTILEMEGA_EVICT_FIRST=1",
      "-DTILEMEGA_EVICT_LAST=0",
      "-DTILEMEGA_PAGE_LOOP_SPLIT=1",
      "-DTILEMEGA_L2_SLIM=0",
      "-DTILEMEGA_WATCHDOG=0",
      "-DTILEMEGA_KPHASE_CLASS_MASK=31",
      "-DTILEMEGA_V3_POLL_NS=0",
      "-DTILEMEGA_PDL=1",
      "-DTILEMEGA_ARCH_PATH_SM80=0",
      "--expt-relaxed-constexpr",
      "-shared",
      "-Xcompiler=-fPIC",
      "-cudart",
      "shared",
      "-Xptxas=-v",
      "-x",
      "cu",
      "-I/root/TileMega/include",
      "-I/root/TileMega/third_party/cutlass/include",
      "-I/root/TileMega/third_party/cutlass/tools/util/include",
      "-I/root/TileMega/third_party/cutlass/test",
      "/root/TileMega/docs/experiments/SERVING_R14/raw/P0_build/qwen3_B16/base/plan.so.cu",
      "-x",
      "cu",
      "/root/TileMega/lib/Target/TargetSpec.cpp",
      "-x",
      "cu",
      "/root/TileMega/lib/Support/Json.cpp",
      "-x",
      "cu",
      "/root/TileMega/lib/Codegen/RuntimeTaskGraph.cpp",
      "-x",
      "cu",
      "/root/TileMega/lib/Solver/PlanMaterialize.cpp",
      "-x",
      "cu",
      "/root/TileMega/lib/Dialect/CouplingGraph/PlacementPlan.cpp",
      "-x",
      "cu",
      "/root/TileMega/lib/Solver/BalancedPlacement.cpp",
      "-x",
      "cu",
      "/root/TileMega/lib/Solver/ListScheduler.cpp",
      "-L/usr/local/cuda/lib64",
      "-lcudart",
      "-o",
      "/root/TileMega/docs/experiments/SERVING_R14/raw/TR4_compile/check.so",
      "-DTILEMEGA_TRACE_STAGE=1",
      "-DTILEMEGA_TRACE_STAGE_SAMPLE=8",
      "-DTILEMEGA_TRACE_TASK=1"
    ]
  }
]
