#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${TILEMEGA_BUILD_DIR:-${repo_dir}/build}"
binary="${build_dir}/tools/tilemega-calibrate"

if [[ ! -x "${binary}" ]]; then
  echo "tilemega-calibrate is not built; run: cmake -S ${repo_dir} -B ${build_dir} -G Ninja && ninja -C ${build_dir} tilemega-calibrate" >&2
  exit 2
fi

exec "${binary}" "$@"
